+  public ApiResponse cancel(String id) {
+    var currentOrder = repository.findById(id);
+    if (!currentOrder.isPresent()) {
+      throw new IllegalArgumentException("Order not found");
+    }
+    var order = currentOrder.get();
+    if (order.status() == OrderStatus.COMPLETED) {
+      return ApiResponse.notFound(Order.ORDER_ALREADY_COMPLETED);
+    }
+    if (order.status() == OrderStatus.CANCELLED) {
+      return ApiResponse.ok(order);
+    }
+    var cancelled = new Order(
+        order.id(),
+        order.requestId(),
+        order.sku(),
+        order.quantity(),
+        OrderStatus.CANCELLED,
+        order.paymentToken(),
+        order.createdAt());
+    repository.save(cancelled);
+    return ApiResponse.ok(cancelled);
